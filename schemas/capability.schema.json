{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zebadee2kk/FrankensteinzHermes/schemas/capability.schema.json",
  "title": "FrankensteinzHermes Capability",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "provider", "version", "side_effect", "risk", "permissions", "trust"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "provider": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "inputs": {"type": "object"},
    "side_effect": {
      "type": "string",
      "enum": ["none", "reversible-write", "external-write", "destructive", "financial", "security-critical"]
    },
    "reversible": {"type": "boolean", "default": false},
    "risk": {"type": "string", "enum": ["L0", "L1", "L2", "L3"]},
    "allowed_data": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "SECRET"]}
    },
    "permissions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "human_approval": {
      "type": "string",
      "enum": ["never", "policy", "always"]
    },
    "execution": {
      "type": "object",
      "properties": {
        "isolation": {"type": "string", "enum": ["core", "container", "sandbox", "vm", "external"]},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "max_calls": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "trust": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["candidate", "approved", "restricted", "quarantined"]},
        "provenance": {"type": "string"},
        "security_review": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
