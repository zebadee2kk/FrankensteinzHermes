[Unit]
Description=FrankensteinzHermes Action Gate v1
After=local-fs.target

[Service]
Type=simple
User=fzh-gate
Group=fzh-gate-clients
ExecStart=/usr/bin/python3 /usr/local/libexec/frankensteinzhermes/action-gate-server.py
Restart=on-failure
RestartSec=2s
UMask=0027
RuntimeDirectory=frankensteinzhermes-gate
RuntimeDirectoryMode=0750
LogsDirectory=frankensteinzhermes-gate
LogsDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
